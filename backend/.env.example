# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/studentsphere for local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studentsphere?retryWrites=true&w=majority

# JWT (use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# First administrator (used by `npm run seed:admin`)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@studentsphere.com
ADMIN_PASSWORD=Admin@12345
